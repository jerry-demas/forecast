{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Web API (.NET)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-webapi",
            "program": "${workspaceFolder}/PartnerForecast.Website.Presentation.WebApi/bin/Debug/net10.0/PartnerForecast.Website.Presentation.WebApi.dll",
            "cwd": "${workspaceFolder}/PartnerForecast.Website.Presentation.WebApi",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5065;https://localhost:7058"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Now listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            }
        },
        {
            "name": "React UI (Chrome)",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/PartnerForecast.Website.Presentation.React"
        }
    ],
    "compounds": [
        {
            "name": "Run UI + API",
            "configurations": [
                "Web API (.NET)",
                "React UI (Chrome)"
            ]
        }
    ]
}